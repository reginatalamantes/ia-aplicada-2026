<mxfile host="app.diagrams.net">
  <diagram name="Ciclo de vida del dato" id="ciclo1">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="1. Captura" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="2. Almacenamiento" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="280" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="3. Uso" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="520" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="4. Compartición" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="760" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="5. Retención" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1000" y="60" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="6. Eliminación" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1240" y="60" width="180" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="t1" value="Qué ocurre: sensores IoT instalados en el edificio capturan datos; se registra año de construcción, tipo de uso y ubicación al dar de alta el inmueble&#10;Responsable: Técnico de instalación / administrador del edificio&#10;Control: Consentimiento del propietario, captura mínima necesaria" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="Qué ocurre: los datos de sensores y el historial de incendios se guardan en una base de datos en la nube&#10;Responsable: Administrador de sistemas&#10;Control: Cifrado en reposo, control de acceso por rol" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="280" y="140" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t3" value="Qué ocurre: el modelo de IA cruza año, uso, ubicación, sensor e historial para predecir riesgo de incendio&#10;Responsable: Ingeniero de IA / analista de datos&#10;Control: Uso limitado al fin declarado, registro de accesos al modelo" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="520" y="140" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t4" value="Qué ocurre: se comparte solo el nivel de riesgo agregado (no el detalle del incidente) con protección civil o aseguradora&#10;Responsable: Líder del proyecto&#10;Control: Agregación obligatoria, contrato de confidencialidad con el tercero" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="760" y="140" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t5" value="Qué ocurre: los registros históricos se conservan por 10 años por requerimiento legal/de seguro&#10;Responsable: Administrador de sistemas&#10;Control: Plazo definido, revisión anual" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1000" y="140" width="180" height="170" as="geometry" />
        </mxCell>
        <mxCell id="t6" value="Qué ocurre: vencido el plazo, o si el propietario lo solicita, se eliminan los registros vinculados al inmueble&#10;Responsable: Administrador de sistemas&#10;Control: Borrado seguro, confirmación documentada" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="1240" y="140" width="180" height="170" as="geometry" />
        </mxCell>

        <mxCell id="th2" value="Tercero:&#10;Proveedor de nube&#10;(base de datos IoT)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="300" y="360" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="th4" value="Tercero:&#10;Protección civil /&#10;aseguradora" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="780" y="360" width="140" height="70" as="geometry" />
        </mxCell>

        <mxCell id="eth2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="n2" target="th2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="eth4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=block;" edge="1" parent="1" source="n4" target="th4"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Recorrido del dato de mayor riesgo: D5 registros de incendios previos -->
        <mxCell id="r1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FF0000;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="130" y="40"/><mxPoint x="370" y="40"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="r2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FF0000;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="40"/><mxPoint x="610" y="40"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="r3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FF0000;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="610" y="40"/><mxPoint x="850" y="40"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="r5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FF0000;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n4" target="n5">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="40"/><mxPoint x="1090" y="40"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="r6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#FF0000;strokeWidth=3;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="n5" target="n6">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="40"/><mxPoint x="1330" y="40"/></Array></mxGeometry>
        </mxCell>

        <mxCell id="leyenda" value="Leyenda: línea roja = recorrido del dato de mayor riesgo (D5, registros de incendios previos). En Compartición (etapa 4), el tercero (protección civil / aseguradora) solo recibe el nivel de riesgo agregado, nunca el detalle del incidente (fecha, causa, afectados) — por eso el control ahí es crítico: es donde D5 en su forma detallada sale del control directo de la organización por primera vez." style="text;html=1;align=left;fontSize=11;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1300" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
